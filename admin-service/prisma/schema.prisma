generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  PENDING
  PASSED
  FAILED
}

model Winner {
  id                String        @id @default(uuid())
  tier              String
  tierCategory      String?
  priorityIndex     Int
  userId            String
  userEmail         String
  userName          String
  postId            String?
  postCaption       String?
  postCategory      String?
  score             Float
  kycStatus         KycStatus     @default(PENDING)
  disqualifiedReason String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  auditLogs         KycAuditLog[]

  @@unique([tier, tierCategory])
  @@index([userId])
  @@index([kycStatus])
  @@index([priorityIndex])
}

model KycAuditLog {
  id             String    @id @default(uuid())
  winnerId       String
  winner         Winner    @relation(fields: [winnerId], references: [id], onDelete: Cascade)
  userId         String
  userEmail      String
  previousStatus KycStatus
  newStatus      KycStatus
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([winnerId])
  @@index([userId])
}
