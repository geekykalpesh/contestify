{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "EXPO_PUBLIC_API_URL": "https://contestify-nfd7.onrender.com",
        "EXPO_PUBLIC_ADMIN_API_URL": "https://contestify-admin-service.onrender.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "1036124006573-eut3o57jvh4r747c7ifl60cncmfnhtum.apps.googleusercontent.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./api-key.json",
        "track": "internal"
      }
    }
  }
}
